local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")

-- ════════════════════════════════
--  CONFIG
-- ════════════════════════════════
local CFG = {
    -- MODE:
    -- "snap"  = instant lock, camera teleports to head, zero smooth
    -- "legit" = smooth human lock (original V13 legit)
    Mode         = "snap",

    FOV          = 45,
    AimPart      = "Head",
    AimOffset    = Vector3.new(0, 0.15, 0),
    TILT         = -12.2,
    TeamCheck    = false,
    VisCheck     = false,
    ChainCooldown= 0.1,
    Predict      = true,
    PredictF     = 0.082,
    VelSmooth    = 0.20,

    -- SNAP specific:
    -- Even in snap mode we add the TINIEST lerp (0.95)
    -- so the camera doesn't literally teleport (looks like
    -- a pixel-perfect human who moves very fast, not a bot)
    -- Set to 1.0 for truly instant (more obvious)
    SnapStrength = 0.95,

    -- LEGIT specific (used when Mode = "legit")
    LegitSmooth  = 0.038,
    LegitMaxAngle= 0.0028,

    -- Shared legit feel even in snap:
    -- Micro jitter so snap isn't perfectly still
    SnapJitter   = true,
    JitterAmt    = 0.4,  -- pixels, tiny

    -- Chain lock
    ChainLock    = true,

    -- Panic
    PanicKey     = Enum.KeyCode.F7,
}

-- ════════════════════════════════
--  SESSION SEED (fingerprint)
-- ════════════════════════════════
local function RR(a,b) return a+math.random()*(b-a) end
local SEED = {
    fovMult   = RR(0.94, 1.06),
    tiltOff   = RR(-1.2, 1.2),
    jitterMult= RR(0.7, 1.3),
}
CFG.FOV  = CFG.FOV  * SEED.fovMult
CFG.TILT = CFG.TILT + SEED.tiltOff

-- ════════════════════════════════
--  STATE
-- ════════════════════════════════
local Active    = true
local Locked    = nil
local LockTimer = 0
local Chaining  = false
local SVel      = Vector3.zero

-- ════════════════════════════════
--  PANIC
-- ════════════════════════════════
UIS.InputBegan:Connect(function(input)
    if input.KeyCode == CFG.PanicKey then
        Active = false
        Locked = nil
        print("[SnakEz] killed")
    end
end)

-- ════════════════════════════════
--  UTIL
-- ════════════════════════════════
local function CX() return Camera.ViewportSize.X/2 end
local function CY() return Camera.ViewportSize.Y/2 end

local function GetPart(p)
    local c = p.Character if not c then return nil end
    return c:FindFirstChild(CFG.AimPart)
        or c:FindFirstChild("UpperTorso")
        or c:FindFirstChild("Torso")
        or c:FindFirstChild("HumanoidRootPart")
        or c.PrimaryPart
end

local function Alive(p)
    local c = p.Character if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function RayOK(pos)
    if not CFG.VisCheck then return true end
    local ig = {LP.Character}
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(ig, p.Character) end
    end
    return workspace:FindPartOnRayWithIgnoreList(
        Ray.new(Camera.CFrame.Position, pos-Camera.CFrame.Position), ig) == nil
end

local function InFOV(pos)
    local _,onS = Camera:WorldToViewportPoint(pos)
    if not onS then return false end
    local toT = (pos-Camera.CFrame.Position).Unit
    local ang = math.deg(math.acos(math.clamp(
        Camera.CFrame.LookVector:Dot(toT),-1,1)))
    return ang <= CFG.FOV/2
end

local function CDist(pos)
    local sc,on = Camera:WorldToViewportPoint(pos)
    if not on then return math.huge end
    return (Vector2.new(sc.X,sc.Y)-Vector2.new(CX(),CY())).Magnitude
end

-- ════════════════════════════════
--  TILT
-- ════════════════════════════════
local function TiltOffset(targetPos)
    local camPos = Camera.CFrame.Position
    local toT    = targetPos - camPos
    local dist   = toT.Magnitude
    local dir    = toT.Unit
    local right  = Camera.CFrame.RightVector
    local rad    = math.rad(CFG.TILT)
    local cos_r  = math.cos(rad)
    local sin_r  = math.sin(rad)
    local rotated = dir*cos_r
        + right:Cross(dir)*sin_r
        + right*right:Dot(dir)*(1-cos_r)
    return camPos + rotated*dist
end

-- ════════════════════════════════
--  FIND TARGET
-- ════════════════════════════════
local function FindTarget()
    local best, bDist = nil, math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP or not Alive(p) then continue end
        if CFG.TeamCheck then
            local ok,s = pcall(function() return p.Team==LP.Team end)
            if ok and s then continue end
        end
        local part = GetPart(p)
        if not part then continue end
        local pos = part.Position + CFG.AimOffset
        if not RayOK(pos) then continue end
        if not InFOV(pos) then continue end
        local sc = Camera:WorldToViewportPoint(pos)
        local sd = (Vector2.new(sc.X,sc.Y)-Vector2.new(CX(),CY())).Magnitude
        if sd < bDist then
            bDist = sd
            best  = {player=p, part=part}
        end
    end
    return best
end

-- ════════════════════════════════
--  LOCK VALID
-- ════════════════════════════════
local function LockValid()
    if not Locked then return false end
    local p = Locked.player
    if not p or not p.Parent then return false end
    if not Alive(p) then return false end
    local part = GetPart(p)
    if not part then return false end
    return InFOV(part.Position + CFG.AimOffset)
end

-- ════════════════════════════════
--  CHAIN
-- ════════════════════════════════
local function Watch(player)
    local c = player.Character if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid") if not h then return end
    h.Died:Connect(function()
        if not CFG.ChainLock then Locked=nil LockTimer=0 return end
        Chaining = true
        Locked   = nil
        task.delay(CFG.ChainCooldown, function()
            Locked    = FindTarget()
            LockTimer = 0
            Chaining  = false
            SVel      = Vector3.zero
            if Locked then Watch(Locked.player) end
        end)
    end)
end

-- ════════════════════════════════
--  MAIN LOOP
-- ════════════════════════════════
RunService.RenderStepped:Connect(function(dt)
    if not Active then return end

    -- Acquire lock
    if not LockValid() and not Chaining then
        local newT = FindTarget()
        if newT then
            if not Locked or Locked.player ~= newT.player then
                Locked    = newT
                LockTimer = 0
                SVel      = Vector3.zero
                Watch(Locked.player)
            end
        else
            Locked    = nil
            LockTimer = 0
        end
    end

    if not Locked then return end
    LockTimer = LockTimer + dt

    local part = GetPart(Locked.player)
    if not part then Locked=nil LockTimer=0 return end

    -- Target pos
    local pos = part.Position + CFG.AimOffset

    -- Predict
    if CFG.Predict then
        local vel = part.AssemblyLinearVelocity
        SVel = SVel:Lerp(vel, CFG.VelSmooth)
        local tt = (Camera.CFrame.Position-pos).Magnitude/500
        pos = pos + SVel*tt*CFG.PredictF
    end

    -- Tilt correction
    local tiltedPos = TiltOffset(pos)

    -- Tiny jitter (even on snap, keeps it from being robot-perfect)
    local jx, jy = 0, 0
    if CFG.SnapJitter then
        jx = (math.random()-0.5) * CFG.JitterAmt * SEED.jitterMult
        jy = (math.random()-0.5) * CFG.JitterAmt * SEED.jitterMult * 0.6
        local right = Camera.CFrame.RightVector
        local up    = Camera.CFrame.UpVector
        tiltedPos   = tiltedPos + right*jx*0.01 + up*jy*0.01
    end

    local desired = CFrame.new(Camera.CFrame.Position, tiltedPos)

    if CFG.Mode == "snap" then
        -- ══ SNAP MODE ══
        -- Nearly instant lock — 0.95 lerp = 95% of the way there each frame
        -- At 60fps this means locked within ~1-2 frames
        -- Looks like an insanely fast human, not a teleport
        Camera.CFrame = Camera.CFrame:Lerp(desired, CFG.SnapStrength)

    else
        -- ══ LEGIT MODE ══
        local angle = math.acos(math.clamp(
            Camera.CFrame.LookVector:Dot(desired.LookVector),-1,1))
        local smooth = CFG.LegitSmooth
        if angle > 0.0001 then
            smooth = math.min(smooth, CFG.LegitMaxAngle/angle)
        end
        Camera.CFrame = Camera.CFrame:Lerp(desired, smooth)
    end
end)

-- ════════════════════════════════
--  RESPAWN
-- ════════════════════════════════
LP.CharacterAdded:Connect(function()
    Locked    = nil
    LockTimer = 0
    Chaining  = false
    SVel      = Vector3.zero
end)

print("[SnakEz] snap lock active | Mode:", CFG.Mode, "| FOV:", math.floor(CFG.FOV))
